# -- Environment variables for xdg-desktop-portal
exec --no-startup-id systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
# Start xdg-desktop-portal services (ensure wlr starts first)
# exec --no-startup-id /usr/lib/xdg-desktop-portal-wlr
# exec --no-startup-id /usr/lib/xdg-desktop-portal -r

exec_always {
	systemctl --user stop xdg-desktop-portal xdg-desktop-portal-wlr
	sleep 1
	systemctl --user start xdg-desktop-portal-wlr
	sleep 1
	systemctl --user start xdg-desktop-portal
}


# -- VARIABLES
# Mod1 for Alt
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

set $term kitty
# set $menu pgrep wofi >/dev/null 2>&1 && killall wofi || wofi --show drun
set $menu rofi -show run
# set $file_explorer nautilus
set $file_explorer thunar

# Visualize open windows app_id
# swaymsg -t get_tree | grep -i 'app_id\|class'
for_window [app_id="org.gnome.Nautilus"] floating enable
for_window [app_id="org.gnome.Loupe"] floating enable
for_window [app_id="org.gnome.Evince"] floating enable
for_window [app_id="xfce4-taskmanager"] floating enable
for_window [app_id="thunar"] floating enable
for_window [class="feh"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="org.qbittorrent.qBittorrent"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="engrampa"] floating enable


# -- SWAYIDLE
